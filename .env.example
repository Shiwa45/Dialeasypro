# ============================================================
# TeleCRM Backend — .env.example
# Copy this file to .env and fill in all values
# NEVER commit the real .env to version control
# ============================================================

# ---- Django Core -------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=your-very-long-random-secret-key-here-change-this
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.telecrm.in

# ---- Database (PostgreSQL 16) ------------------------------
DB_ENGINE=django_tenants.postgresql_backend
DB_NAME=telecrm_db
DB_USER=telecrm_user
DB_PASSWORD=your_db_password_here
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=require

# ---- Redis -------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ---- Domain Configuration ----------------------------------
# Primary domain for the platform (public schema serves this)
BASE_DOMAIN=telecrm.in
# Admin subdomain for super admin
SUPER_ADMIN_DOMAIN=admin.telecrm.in

# ---- AWS S3 (File Storage: Call Recordings, Uploads) -------
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_STORAGE_BUCKET_NAME=telecrm-storage-dev
AWS_S3_REGION_NAME=ap-south-1
# Use CloudFront CDN URL if available, else S3 URL
AWS_S3_CUSTOM_DOMAIN=
# Presigned URL expiry in seconds (for call recordings = 1 hour)
AWS_S3_PRESIGNED_EXPIRY=3600
# Set to False to disable; True in production
USE_S3=False

# ---- Email (Django Email Backend) --------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Production: use SMTP or SES
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=your_sendgrid_api_key
DEFAULT_FROM_EMAIL=TeleCRM <noreply@telecrm.in>
SUPPORT_EMAIL=support@telecrm.in

# ---- AWS SES (Bulk Email) ----------------------------------
AWS_SES_REGION_NAME=ap-south-1
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=

# ---- Razorpay (Payments - India) ---------------------------
RAZORPAY_KEY_ID=rzp_test_yourkeyhere
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
# Razorpay plans (create these in Razorpay dashboard)
RAZORPAY_PLAN_ID_STARTER_MONTHLY=plan_xxxx
RAZORPAY_PLAN_ID_GROWTH_MONTHLY=plan_xxxx
RAZORPAY_PLAN_ID_BUSINESS_MONTHLY=plan_xxxx
RAZORPAY_PLAN_ID_STARTER_YEARLY=plan_xxxx
RAZORPAY_PLAN_ID_GROWTH_YEARLY=plan_xxxx
RAZORPAY_PLAN_ID_BUSINESS_YEARLY=plan_xxxx

# ---- Firebase (Push Notifications) -------------------------
FIREBASE_SERVER_KEY=your_firebase_server_key
FIREBASE_PROJECT_ID=your_firebase_project_id
GOOGLE_APPLICATION_CREDENTIALS=/path/to/firebase-service-account.json

# ---- TRAI DND Scrubbing (India Compliance) -----------------
TRAI_DND_ENABLED=False
TRAI_DND_API_KEY=
TRAI_DND_API_URL=https://api.ndnc.org.in/scrubber/

# ---- Sentry (Error Monitoring) -----------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# ---- Security (Production) ---------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0

# ---- JWT Configuration -------------------------------------
# JWT access token lifetime in minutes
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
# JWT refresh token lifetime in days
JWT_REFRESH_TOKEN_LIFETIME_DAYS=30

# ---- Celery Configuration ----------------------------------
CELERY_TIMEZONE=Asia/Kolkata
CELERY_TASK_ALWAYS_EAGER=False

# ---- Feature Flags -----------------------------------------
MAINTENANCE_MODE=False
ALLOW_NEW_REGISTRATIONS=True
DEFAULT_TRIAL_DAYS=14

# ---- WhatsApp (will be configured per-tenant, these are fallback defaults)
DEFAULT_WHATSAPP_PROVIDER=wati
META_WHATSAPP_VERIFY_TOKEN=your_meta_verify_token_here

# ---- Logging -----------------------------------------------
LOG_LEVEL=DEBUG
LOG_FILE=/var/log/telecrm/app.log

# ============================================================
# Phase 3: Communication Providers
# ============================================================

# WhatsApp — Interakt (get from app.interakt.ai)
INTERAKT_API_KEY=your_interakt_api_key_here

# WhatsApp — AiSensy (get from app.aisensy.com)
AISENSY_API_KEY=your_aisensy_api_key_here

# SMS — MSG91 (get from msg91.com)
MSG91_AUTH_KEY=your_msg91_auth_key_here
MSG91_SENDER_ID=TELCRM

# SMS — TextLocal (get from textlocal.in)
TEXTLOCAL_API_KEY=your_textlocal_api_key_here

# Meta (Facebook) Lead Ads
META_APP_SECRET=your_meta_app_secret_here
META_VERIFY_TOKEN=any_random_secret_string_you_choose

# Google Ads Lead Forms
GOOGLE_ADS_DEVELOPER_TOKEN=your_google_ads_developer_token

# IndiaMART Lead Manager API
INDIAMART_KEY=your_indiamart_key_here
