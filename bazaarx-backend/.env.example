# ============================================
# BazaarX Backend - Environment Configuration
# Copy to .env and fill real values for local dev
# ============================================

# --- App ---
NODE_ENV=development
APP_NAME=BazaarX
APP_PORT=3000
API_PREFIX=api
API_VERSION=v1

# --- PostgreSQL (primary relational DB) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=bazaarx
POSTGRES_PASSWORD=bazaarx_dev_password
POSTGRES_DB=bazaarx
POSTGRES_SYNCHRONIZE=false
POSTGRES_LOGGING=true

# --- MongoDB (logs, specs, cart sessions, CMS) ---
MONGO_URI=mongodb://localhost:27017/bazaarx

# --- Redis (cache, sessions, OTP, rate limit) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# --- Elasticsearch (product search) ---
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# --- JWT Auth ---
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars_long
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars_long
JWT_REFRESH_EXPIRY=30d

# --- OTP ---
OTP_LENGTH=6
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# --- SMS Provider (MSG91 - India) ---
MSG91_AUTH_KEY=
MSG91_SENDER_ID=BAZRX
MSG91_OTP_TEMPLATE_ID=

# --- Social Auth (Google) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Rate Limiting ---
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# --- Razorpay (payments) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Shiprocket (logistics) ---
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_PINCODE=560001
SHIPROCKET_PICKUP_LOCATION=Primary
SHIPROCKET_WEBHOOK_TOKEN=
