# Production environment variables for Docker deployment.
# Copy this file to .env and replace placeholder values.

DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=<YOUR_SECRET_KEY>
DEBUG=False
ALLOWED_HOSTS=16.171.200.58
BASE_DOMAIN=telecrm.in
SUPER_ADMIN_DOMAIN=admin.telecrm.in

DB_NAME=telecrm_db
DB_USER=telecrm_user
DB_PASSWORD=<YOUR_DB_PASSWORD>
DB_HOST=database-1.cleiw2sogobg.eu-north-1.rds.amazonaws.com
DB_PORT=5432

REDIS_PASSWORD=<YOUR_REDIS_PASSWORD>
REDIS_URL=redis://:<YOUR_REDIS_PASSWORD>@redis:6379/0
CELERY_BROKER_URL=redis://:<YOUR_REDIS_PASSWORD>@redis:6379/1
CELERY_RESULT_BACKEND=redis://:<YOUR_REDIS_PASSWORD>@redis:6379/2

USE_S3=False

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Optional production email settings
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=<YOUR_SMTP_API_KEY>

# Sentry / logging
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# Feature flags
MAINTENANCE_MODE=False
ALLOW_NEW_REGISTRATIONS=True
DEFAULT_TRIAL_DAYS=14
