<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ═══ CORE PERMISSIONS ═══ -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>

    <!-- ═══ DIRECT DIALING ═══ -->
    <!-- CALL_PHONE allows the app to initiate a phone call without going
         through the Dialer UI for the user to confirm the call -->
    <uses-permission android:name="android.permission.CALL_PHONE"/>
    <uses-permission android:name="android.permission.READ_PHONE_STATE"/>
    <uses-permission android:name="android.permission.READ_PHONE_NUMBERS"/>
    <uses-permission android:name="android.permission.READ_CALL_LOG"/>
    <uses-permission android:name="android.permission.PROCESS_OUTGOING_CALLS"/>

    <!-- ═══ AUDIO (Voice notes during/after calls) ═══ -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>

    <!-- ═══ FOREGROUND SERVICE (mic access during a call) ═══
         RECORD_AUDIO is a "while in use" permission. Once the agent taps Call
         the system dialer comes forward and this app is backgrounded, and a
         backgrounded app gets silence from the mic on Android 11+ and is
         refused outright on 12+. A foreground service with the `microphone`
         type is the documented way to keep that access across the transition.
         FOREGROUND_SERVICE_MICROPHONE is required from Android 14 (targetSdk
         34) and is ignored on older releases. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE"/>

    <!-- Lets setup offer a one-tap battery-optimisation exemption. Xiaomi,
         Vivo, Oppo/Realme and Transsion ROMs freeze backgrounded apps, which
         stalls the post-call recording sweep. Play restricts this permission:
         justify it under the app's call-management use, or drop this line and
         the wizard falls back to opening the general battery settings list. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>

    <!-- ═══ DEVICE ═══ -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.VIBRATE"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
    <uses-permission android:name="android.permission.USE_EXACT_ALARM"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>

    <!-- ═══ CONTACTS (optional, for import) ═══ -->
    <uses-permission android:name="android.permission.READ_CONTACTS"/>

    <!-- ═══ STORAGE (for cached files) ═══ -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32"/>

    <!-- ═══ CALL-RECORDING ACCESS ═══
         SIM-based call recording is captured by the phone's own OEM recorder;
         the app reads those audio files and uploads them. Access strategy:
           - Android 13+ : READ_MEDIA_AUDIO (read audio via MediaStore)
           - Android ≤12 : READ_EXTERNAL_STORAGE (declared above)
           - Broadest    : MANAGE_EXTERNAL_STORAGE ("All files access") so the
                           app can read OEM call-recording folders that are NOT
                           indexed by MediaStore (Samsung/MIUI/etc.). This is a
                           Play-restricted permission — declare "call management"
                           as the app's core use in the Play Console. -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO"/>
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"/>

    <!-- Optional features (so app installs on tablets without phone hardware) -->
    <uses-feature android:name="android.hardware.telephony" android:required="false"/>
    <uses-feature android:name="android.hardware.microphone" android:required="false"/>

    <application
        android:label="DialEasypro"
        android:name="${applicationName}"
        android:icon="@drawable/ic_launcher"
        android:requestLegacyExternalStorage="true"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">

            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme"/>

            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2"/>

        <!-- Holds the microphone while a call is in progress. Started at dial
             time, while the app is still visible: Android 12+ forbids starting
             a foreground service from the background, so starting it when the
             call CONNECTS (the app is behind the dialer by then) throws. -->
        <service
            android:name=".CallAudioService"
            android:exported="false"
            android:stopWithTask="true"
            android:foregroundServiceType="microphone"/>
    </application>

    <!-- ═══ INTENT QUERIES (Android 11+ package visibility) ═══ -->
    <queries>
        <!-- Phone dialer -->
        <intent>
            <action android:name="android.intent.action.DIAL"/>
            <data android:scheme="tel"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.CALL"/>
            <data android:scheme="tel"/>
        </intent>
        <!-- WhatsApp (native) -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https" android:host="wa.me"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="whatsapp"/>
        </intent>
        <!-- SMS -->
        <intent>
            <action android:name="android.intent.action.SENDTO"/>
            <data android:scheme="smsto"/>
        </intent>
        <!-- Email -->
        <intent>
            <action android:name="android.intent.action.SENDTO"/>
            <data android:scheme="mailto"/>
        </intent>
        <!-- Web browser -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <!-- Text processing (share text) -->
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
