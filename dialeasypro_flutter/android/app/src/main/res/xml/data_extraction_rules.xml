<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: keep app data out of cloud backup and device-to-device
     transfer. The signed-in session (access and refresh tokens) lives in
     SharedPreferences; a backup would carry it to another device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
